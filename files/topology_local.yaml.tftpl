global:
  user: "tidb"
  ssh_port: 22
  deploy_dir: "/tidb-deploy"

server_configs:
  %{~ if length(tidb_hosts) > 0 ~}
  tidb: {}
  %{~ endif ~}
  %{~ if length(tikv_hosts) > 0 ~}
  tikv:
    cdc.min-ts-interval: 1s
    storage.block-cache.capacity: "16GB"
    rocksdb.titan.enabled: true
    rocksdb.defaultcf.titan.min-blob-size: "1KB"
  %{~ endif ~}
  pd:
    schedule.enable-cross-table-merge: false
  %{~ if length(tiflash_hosts) > 0 ~}
  tiflash: {}
  %{~ endif ~}

%{~ if length(tidb_hosts) > 0 ~}
tidb_servers:
  %{~ for host in tidb_hosts ~}
  - host: ${host}
  %{~ endfor ~}
%{~ endif ~}

%{~ if length(tikv_hosts) > 0 ~}
tikv_servers:
  %{~ for host in tikv_hosts ~}
  - host: ${host}
  %{~ endfor ~}
%{~ endif ~}

%{~ if length(tiflash_hosts) > 0 ~}
tiflash_servers:
  %{~ for host in tiflash_hosts ~}
  - host: ${host}
  %{~ endfor ~}
%{~ endif ~}

%{~ if length(ticdc_local_hosts) > 0 ~}
cdc_servers:
  %{~ for host in ticdc_local_hosts ~}
  - host: ${host}
    data_dir: /mnt/ticdc/data
  %{~ endfor ~}
%{~ endif ~}

pd_servers:
  - host: 172.31.8.1

monitoring_servers:
  - host: 172.31.8.1

grafana_servers:
  - host: 172.31.8.1
