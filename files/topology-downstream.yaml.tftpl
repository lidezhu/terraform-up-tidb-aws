global:
  user: "tidb"
  ssh_port: 22
  deploy_dir: "/tidb-deploy"

server_configs:
  %{~ if length(tidb_hosts) > 0 ~}
  tidb: {}
  %{~ endif ~}
  %{~ if length(tikv_hosts) > 0 ~}
  tikv: {}
  %{~ endif ~}
  pd: {}

%{~ if length(tidb_hosts) > 0 ~}
tidb_servers:
  %{~ for host in tidb_hosts ~}
  - host: ${host}
  %{~ endfor ~}
%{~ endif ~}

%{~ if length(tikv_hosts) > 0 ~}
tikv_servers:
  %{~ for host in tikv_hosts ~}
  - host: ${host}
  %{~ endfor ~}
%{~ endif ~}

pd_servers:
  - host: 172.31.18.1

monitoring_servers:
  - host: 172.31.18.1

grafana_servers:
  - host: 172.31.18.1
